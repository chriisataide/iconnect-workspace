__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Banco e mídia locais
db.sqlite3
db.sqlite3-journal
/media/
/staticfiles/

# Anexos do Workspace. Fora de MEDIA_ROOT por decisão de segurança, e fora do
# git pelo motivo óbvio: são comprovantes e atestados de pessoas reais.
/arquivos_privados/

# Cobertura e relatórios
.coverage
coverage.json
htmlcov/
junit.xml
.pytest_cache/

# Ambiente
.env
.env.*
!.env.example

# Chaves e certificados. Nunca houve nenhum neste repositório — a auditoria de
# agosto de 2026 varreu os 65 commits e não achou segredo em lugar nenhum. As
# linhas abaixo existem para que continue assim: o modo normal de vazar chave
# privada é um `git add .` num diretório onde alguém deixou uma.
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
*.jks
credentials.json
service-account*.json

# Editores e SO
.DS_Store
.idea/
.vscode/

# Saída do inventário do monday — `scripts/inventario_monday.py`.
#
# O JSON traz nome de cliente e de colaborador reais: é o levantamento dos
# boards de verdade da ADB, e o próprio script avisa isso ao terminar. Ele é
# insumo para escrever o conector, não artefato do produto.
#
# A fixture de teste consome uma amostra ANONIMIZADA, versionada em
# docs/exemplos/monday-inventario-exemplo.json — e é ela que entra no git.
monday_inventario.json
monday_inventario.md
monday_inventario*.json
monday_inventario*.md

# Arquivos de troca do editor. `.CLAUDE.md.swp` já apareceu numa listagem de
# `git status` — vim deixa isto para trás quando a sessão morre, e o nome
# começando com ponto engana quem varre o diretório à vista.
*.swp
*.swo
*~
.playwright-mcp/
.env.ponto.local
