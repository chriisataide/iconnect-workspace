# Configuração local da automação de pendências de ponto.
#
#     cp .env.example .env
#
# O README manda copiar este arquivo desde a primeira versão, e ele não existia
# no repositório — quem seguia o passo a passo parava aqui. Este é o arquivo
# que faltava.
#
# Gere TRÊS valores diferentes e fortes:
#
#     openssl rand -hex 32
#
# Nenhum valor daqui vai para o Git: `.env` está ignorado. Não coloque
# credencial dentro do workflow nem em variável de template.

# ── Banco ───────────────────────────────────────────────────────────
POSTGRES_USER=ponto
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE

# ── n8n ─────────────────────────────────────────────────────────────
N8N_ENCRYPTION_KEY=SUBSTITUA_POR_openssl_rand_hex_32

# O token que o PORTAL manda no header `Authorization: Bearer <token>`.
# Precisa ser exatamente igual ao `N8N_PONTO_TOKEN` do ambiente do Django:
# o workflow do Portal recusa a chamada quando os dois não batem.
N8N_PONTO_TOKEN=SUBSTITUA_POR_openssl_rand_hex_32

# ── Evolution API ───────────────────────────────────────────────────
EVOLUTION_API_KEY=SUBSTITUA_POR_openssl_rand_hex_32
EVOLUTION_URL=http://evolution-api:8080
EVOLUTION_INSTANCE=teste-pessoal

# ── Modo de teste ───────────────────────────────────────────────────
#
# Estas duas valem para o workflow ANTIGO, o de gatilho manual que lê o Excel
# montado. O workflow do Portal não as usa: lá o modo e o telefone de teste
# vêm no corpo de cada chamada, porque quem decide isso passou a ser o Portal.
#
# Mantenha `true` aqui de qualquer forma. Um `.env` de desenvolvimento com
# `TEST_MODE=false` é um disparo real à espera de um `docker compose up`.
TEST_MODE=true

# Seu WhatsApp pessoal, só dígitos, no formato 55 + DDD + número.
# O valor abaixo é ilustrativo e precisa ser trocado.
TEST_PHONE=5519999999999
